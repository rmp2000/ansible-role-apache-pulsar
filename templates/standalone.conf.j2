# Managed by Ansible. One JVM with embedded BookKeeper and RocksDB metadata.
clusterName=standalone
bindAddress={{ apache_pulsar_bind_address }}
advertisedAddress={{ apache_pulsar_bind_address }}
# The embedded BookKeeper shares this configuration; permit local-only tests.
allowLoopback=true
brokerServicePort=
webServicePort=
brokerServicePortTls={{ apache_pulsar_broker_port }}
webServicePortTls={{ apache_pulsar_admin_port }}
tlsCertificateFilePath=/etc/apache-pulsar/tls/server.crt
tlsKeyFilePath=/etc/apache-pulsar/tls/server.key
tlsTrustCertsFilePath=/etc/apache-pulsar/tls/server.crt
tlsAllowInsecureConnection=false
authenticationEnabled=true
authorizationEnabled=true
authenticationProviders=org.apache.pulsar.broker.authentication.AuthenticationProviderToken
tokenSecretKey=file:///etc/apache-pulsar/token.key
superUserRoles=admin
brokerClientAuthenticationPlugin=org.apache.pulsar.client.impl.auth.AuthenticationToken
brokerClientAuthenticationParameters=file:///etc/apache-pulsar/admin.token
brokerClientTlsEnabled=true
brokerClientTrustCertsFilePath=/etc/apache-pulsar/tls/server.crt
tlsHostnameVerificationEnabled=true
managedLedgerDefaultEnsembleSize=1
managedLedgerDefaultWriteQuorum=1
managedLedgerDefaultAckQuorum=1
defaultNumberOfNamespaceBundles=1
defaultNumberOfSystemNamespaceBundles=1
numIOThreads=4
numOrderedExecutorThreads=4
numHttpServerThreads=4
